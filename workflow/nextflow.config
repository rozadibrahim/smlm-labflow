// SMLM LabFlow - Nextflow configuration (mirrors config/config.yaml).
//
// Drives workflow/main.nf, the SECOND registry-driven emitter (the first is
// workflow/Snakefile). Same methods (config/methods.yaml), same `labflow run`
// commands, same output tree -- pick the engine per deployment:
//
//   nextflow run workflow/main.nf -c workflow/nextflow.config
//   nextflow run workflow/main.nf -profile slurm --drift_method aim_julia
//   labflow pipeline --engine nextflow --profile slurm --config track=true
//
// Override any param on the CLI (--drift_method dme) or with -params-file.

params {
    repo              = "${projectDir}/.."          // repo root (workflow/ sits under it)
    input_dir         = "data/movies"
    profile           = "profiles/liteloc_unified_example.yaml"
    run_dir           = "outputs/nextflow_run"
    backend           = "liteloc"
    extra_infer_args  = "--export raw"

    // LiteLoc lifecycle (optional) -- off by default; a normal run is infer->drift->report
    calibrate         = false
    train             = false
    calibrate_input   = "data/beads"
    train_input       = "data/train"

    // stage selection + per-method params (mirror config/config.yaml)
    pixel_size_nm     = 127
    units             = "nm"

    drift_method      = "rcc"
    drift_params      = [ rcc:       [n_time_bins: 30, render_nm: 20, neighbor_span: 6, max_drift_nm: 1000],
                          aim_julia: [intersect_nm: 20, track_interval: 500],
                          dme:       [frames_per_bin: 1, coarse_frames_per_bin: 200, use_cuda: true] ]

    track             = false
    track_method      = "magik"
    track_params      = [ magik: [connectivity_radius: 1.0, n_frames: 3] ]

    cluster           = false
    cluster_method    = "dbscan"
    cluster_params    = [ dbscan: [eps: 100, min_samples: 10], optics: [min_samples: 10],
                          hdbscan: [min_cluster_size: 20] ]

    spatial_stats        = false
    spatial_stats_method = "ripley"
    spatial_stats_params = [ ripley: [r_max: 500, n_bins: 50], paircorrelation: [r_max: 500, n_bins: 50] ]

    counting          = false
    counting_method   = "qpaint"
    counting_params   = [:]

    phenotype         = false
    phenotype_method  = "clusternet"
    phenotype_params  = [:]

    analyze           = false
    analyze_method    = "deeptrace"
    analyze_params    = [ deeptrace: [:] ]
}

// Execution profiles -- the payoff for Nextflow. labflow already isolates each tool
// (per-method runtime), so these only choose WHERE jobs run, not how they're isolated.
// Per-site settings: add conf/<your_lab>.config (see conf/README.md) and layer it with
//   labflow pipeline --engine nextflow -c conf/<your_lab>.config
profiles {
    standard  { process.executor = 'local' }
    slurm     { process.executor = 'slurm';    process.cpus = 4 }
    awsbatch  { process.executor = 'awsbatch'; process.queue = 'CHANGE-ME'; aws.region = 'eu-west-1' }
    apptainer { apptainer.enabled = true }      // optional; per-tool isolation is already handled
}
